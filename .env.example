PORT=3000
# Where the JSON data lives. On a host, point this at a persistent disk.
DATA_DIR=./data
# Watchlist CSV imported on first start (when DATA_DIR has no watchlist yet)
WATCHLIST_CSV=./seed/watchlist.csv
# Public URL of the dashboard (linked from the email)
APP_URL=https://your-domain.example

# Benchmark + thresholds
BENCH_DATE=2026-09-29
ALERT_PCT=-5
SPIKE_PCT=10
# Daily close job, America/Chicago time (min hour dom mon dow)
DAILY_CRON=20 15 * * 1-5

# Daily email (any SMTP: Gmail app password, SendGrid, Mailgun, SES, ...)
MAIL_TO=vikrantha@yahoo.com
MAIL_FROM=Watchlist <alerts@your-domain.example>
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# Protects /api/admin/* (run-daily, watchlist upload). Use a long random string.
ADMIN_KEY=
REFRESH_COOLDOWN_SEC=60
FETCH_CONCURRENCY=6
